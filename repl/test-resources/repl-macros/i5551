scala> import scala.quoted._
scala> class MyException extends Exception { }
// defined class MyException
scala> def assertImpl(expr: Expr[Boolean])(using q: Quotes) = '{ if !($expr) then throw new MyException()}
def assertImpl(expr: Expr[Boolean])(using q: Quotes): Expr[Unit]
scala>   inline def assert(expr: => Boolean): Unit =  ${ assertImpl('{expr}) }
def assert(expr: => Boolean): Unit

scala> assert(0 == 0)

scala> try assert(0 == 1) catch { case _: MyException => println("ok") }
ok
