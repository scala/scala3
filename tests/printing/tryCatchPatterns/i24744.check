package <empty> {
  class A() extends Exception() {}
  class B() extends Exception() {}
  final lazy module val X: X = new X()
  final module class X() extends Object() {
    private def writeReplace(): AnyRef =
      new scala.runtime.ModuleSerializationProxy(classOf[X.type])
    def run: Unit =
      try throw new Exception() catch
        {
          case _:(A | B) =>
            println("A | B")
          case _ =>
            println("default")
        }
  }
}

