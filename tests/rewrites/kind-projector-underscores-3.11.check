trait Foo[F[_]]
trait Qux[F[_, _]]
trait Baz[F[_], A, B]

class Bar1 extends Foo[Either[Int, _]]
class Bar2 extends Foo[_ => Int]
class Bar3 extends Foo[(Int, _, Int)]
class Bar4 extends Qux[Either[+_, -_]]
class Bar5 extends Foo[[x] =>> Either[Int, x]]
class Bar6 extends Qux[[x, y] =>> Either[y, x]]
class Bar7 extends Foo[[x] =>> Baz[x => _, Int, x]]
class Bar8 extends Qux[Map[_, _]]
