#!/usr/bin/env bash

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" >& /dev/null && pwd)/.."
. $ROOT/bin/commonQ

# Runs a class compiled with bin/scalacQ on the classpath written by `sbt buildQuick`
# (compiler + freshly built stdlib).
#
#   bin/scalacQ -d out MyFile.scala
#   bin/scalaQ -cp out MyMain arg1
#
# Without -cp, classes are looked up in the current directory.

extraCp="."
if [ "$1" = "-cp" ] || [ "$1" = "-classpath" ]; then
  extraCp="$2"
  shift 2
fi

java -cp "$extraCp:$cp" "$@"
